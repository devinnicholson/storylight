STORYLIGHT_ENVIRONMENT=development
STORYLIGHT_DATA_DIR=.storylight/data
STORYLIGHT_CACHE_DIR=.storylight/cache
STORYLIGHT_MODEL_BACKEND=ollama
STORYLIGHT_MODEL_NAME=gemma4:e2b-it-qat
STORYLIGHT_MODEL_BASE_URL=http://127.0.0.1:11434
STORYLIGHT_MODEL_API_KEY=
STORYLIGHT_MODEL_TIMEOUT_SECONDS=180
STORYLIGHT_MODEL_KEEP_ALIVE=10m
STORYLIGHT_ASSET_BACKEND=disabled
# auto | disabled | fake | modal | modal_warm | gcp_cloud_run
STORYLIGHT_LIVE_SCENE_BACKEND=auto
STORYLIGHT_LIVE_SCENE_ENABLE_MOTION=false
STORYLIGHT_LIVE_SCENE_MODAL_SESSION_GPU_CAP_USD=1.0
# Private GCP renderer; URL and audience are normally the same Cloud Run service URL.
STORYLIGHT_LIVE_SCENE_GCP_URL=
STORYLIGHT_LIVE_SCENE_GCP_AUDIENCE=
STORYLIGHT_LIVE_SCENE_GCP_IMPERSONATE_SERVICE_ACCOUNT=
STORYLIGHT_LIVE_SCENE_GCP_GPU=RTX_PRO_6000
STORYLIGHT_LIVE_SCENE_GCP_TIMEOUT_SECONDS=180
STORYLIGHT_LIVE_SCENE_GCP_SESSION_GPU_CAP_USD=0.50
# inline | deferred. Deferred skips the inline Grounding DINO retry so the first
# plate can project immediately; use it with the post-projection critic below.
STORYLIGHT_LIVE_SCENE_FIDELITY_MODE=inline
# disabled | nemotron. Criticism happens only after the master is already visible.
STORYLIGHT_LIVE_SCENE_CRITIC_BACKEND=disabled
STORYLIGHT_LIVE_SCENE_CRITIC_URL=
STORYLIGHT_LIVE_SCENE_CRITIC_AUDIENCE=
STORYLIGHT_LIVE_SCENE_CRITIC_API_KEY=
STORYLIGHT_LIVE_SCENE_CRITIC_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
STORYLIGHT_LIVE_SCENE_CRITIC_TIMEOUT_SECONDS=90
STORYLIGHT_ASSET_MODEL=z-image-turbo
STORYLIGHT_ASSET_COMMAND=mflux-generate-z-image-turbo
STORYLIGHT_ASSET_DEPTH_COMMAND=mflux-save-depth
STORYLIGHT_ASSET_MODAL_COMMAND=modal
STORYLIGHT_ASSET_MODAL_APP=deploy/modal_scene_foundry.py
STORYLIGHT_ASSET_MODAL_STEPS=4
STORYLIGHT_ASSET_WIDTH=1024
STORYLIGHT_ASSET_HEIGHT=576
STORYLIGHT_ASSET_STEPS=9
STORYLIGHT_ASSET_QUANTIZE=4
STORYLIGHT_ASSET_TIMEOUT_SECONDS=1800
STORYLIGHT_ASSET_LOW_RAM=true
STORYLIGHT_ASR_BACKEND=mlx_whisper
STORYLIGHT_ASR_MODEL=.models/whisper-base.en
STORYLIGHT_ASR_ENGINE_PATH=
STORYLIGHT_ASR_MAX_AUDIO_MB=20
STORYLIGHT_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
