BOOKFORGE_ENVIRONMENT=development
BOOKFORGE_DATA_DIR=.bookforge/data
BOOKFORGE_CACHE_DIR=.bookforge/cache
BOOKFORGE_MODEL_BACKEND=ollama
BOOKFORGE_MODEL_NAME=gemma4:e2b-it-qat
BOOKFORGE_MODEL_BASE_URL=http://127.0.0.1:11434
BOOKFORGE_MODEL_API_KEY=
BOOKFORGE_MODEL_TIMEOUT_SECONDS=180
BOOKFORGE_MODEL_KEEP_ALIVE=10m
BOOKFORGE_ASSET_BACKEND=disabled
# auto | disabled | fake | modal | modal_warm | gcp_cloud_run
BOOKFORGE_LIVE_SCENE_BACKEND=auto
BOOKFORGE_LIVE_SCENE_ENABLE_MOTION=false
BOOKFORGE_LIVE_SCENE_MODAL_SESSION_GPU_CAP_USD=1.0
# Private GCP renderer; URL and audience are normally the same Cloud Run service URL.
BOOKFORGE_LIVE_SCENE_GCP_URL=
BOOKFORGE_LIVE_SCENE_GCP_AUDIENCE=
BOOKFORGE_LIVE_SCENE_GCP_IMPERSONATE_SERVICE_ACCOUNT=
BOOKFORGE_LIVE_SCENE_GCP_GPU=RTX_PRO_6000
BOOKFORGE_LIVE_SCENE_GCP_TIMEOUT_SECONDS=180
BOOKFORGE_LIVE_SCENE_GCP_SESSION_GPU_CAP_USD=0.50
# disabled | nemotron. Criticism happens only after the master is already visible.
BOOKFORGE_LIVE_SCENE_CRITIC_BACKEND=disabled
BOOKFORGE_LIVE_SCENE_CRITIC_URL=
BOOKFORGE_LIVE_SCENE_CRITIC_AUDIENCE=
BOOKFORGE_LIVE_SCENE_CRITIC_API_KEY=
BOOKFORGE_LIVE_SCENE_CRITIC_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
BOOKFORGE_LIVE_SCENE_CRITIC_TIMEOUT_SECONDS=90
BOOKFORGE_ASSET_MODEL=z-image-turbo
BOOKFORGE_ASSET_COMMAND=mflux-generate-z-image-turbo
BOOKFORGE_ASSET_DEPTH_COMMAND=mflux-save-depth
BOOKFORGE_ASSET_MODAL_COMMAND=modal
BOOKFORGE_ASSET_MODAL_APP=deploy/modal_scene_foundry.py
BOOKFORGE_ASSET_MODAL_STEPS=4
BOOKFORGE_ASSET_WIDTH=1024
BOOKFORGE_ASSET_HEIGHT=576
BOOKFORGE_ASSET_STEPS=9
BOOKFORGE_ASSET_QUANTIZE=4
BOOKFORGE_ASSET_TIMEOUT_SECONDS=1800
BOOKFORGE_ASSET_LOW_RAM=true
BOOKFORGE_ASR_BACKEND=mlx_whisper
BOOKFORGE_ASR_MODEL=.models/whisper-base.en
BOOKFORGE_ASR_ENGINE_PATH=
BOOKFORGE_ASR_MAX_AUDIO_MB=20
BOOKFORGE_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
