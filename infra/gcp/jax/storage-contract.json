{
  "schema_version": "1.0",
  "buckets": {
    "scratch": {
      "must_differ_from": "release",
      "uniform_bucket_level_access": true,
      "public_access_prevention": "enforced",
      "lifecycle": "scratch-lifecycle.json",
      "maximum_age_days": 7
    },
    "release": {
      "must_differ_from": "scratch",
      "uniform_bucket_level_access": true,
      "public_access_prevention": "enforced",
      "lifecycle": "release-lifecycle.json",
      "automatic_deletion": false,
      "completion_object": "completion.json",
      "completion_written_last": true
    }
  }
}
