# Standalone profile. Copy to /etc/bookforge/bookforge.env only after
# Gemma and Modal have independently passed their readiness checks.
BOOKFORGE_ENVIRONMENT=jetson
BOOKFORGE_DATA_DIR=/var/lib/bookforge
BOOKFORGE_CACHE_DIR=/var/cache/bookforge

# Private local scene planner on Jetson.
BOOKFORGE_MODEL_BACKEND=ollama
BOOKFORGE_MODEL_NAME=gemma3:1b-it-q4_K_M
BOOKFORGE_MODEL_BASE_URL=http://127.0.0.1:11434
BOOKFORGE_MODEL_API_KEY=
BOOKFORGE_MODEL_TIMEOUT_SECONDS=12
BOOKFORGE_MODEL_CONTEXT_TOKENS=4096
BOOKFORGE_MODEL_MAX_OUTPUT_TOKENS=180
BOOKFORGE_MODEL_REQUIRE_GPU=true
# A standalone judged appliance keeps its one accepted 1B planner resident.
# Use a bounded duration instead on shared/development devices.
BOOKFORGE_MODEL_KEEP_ALIVE=-1m
BOOKFORGE_LIVE_SCENE_PLANNER=model
# Default remains the configured Ollama client. The guarded TensorRT promotion
# helper atomically changes these settings only after the exact engine passes.
BOOKFORGE_LIVE_SCENE_PLANNER_BACKEND=configured
BOOKFORGE_LIVE_SCENE_PLANNER_BASE_URL=http://127.0.0.1:11435
BOOKFORGE_LIVE_SCENE_PLANNER_MODEL_NAME=llm
BOOKFORGE_LIVE_SCENE_PLANNER_MAX_OUTPUT_TOKENS=64
BOOKFORGE_LIVE_SCENE_PLANNER_FALLBACK_READY_SECONDS=5
BOOKFORGE_LIVE_SCENE_PLANNER_TIMEOUT_SECONDS=12
BOOKFORGE_LIVE_SCENE_PLANNER_CACHE_ENTRIES=32
BOOKFORGE_LIVE_SCENE_PLANNER_AUTO_WARMUP=true
BOOKFORGE_LIVE_SCENE_PLANNER_COMPACT_WIRE=false

# Resilient renderer order: private Cloud Run RTX, managed Vertex image, then
# authenticated Modal. Failed readiness probes fall through; an ambiguous paid
# request always fails closed instead of launching a duplicate render.
BOOKFORGE_ASSET_BACKEND=modal
BOOKFORGE_ASSET_MODAL_COMMAND=/opt/bookforge/.venv/bin/modal
BOOKFORGE_LIVE_SCENE_BACKEND=gcp_resilient
BOOKFORGE_LIVE_SCENE_MODAL_PLAN_FILE=/opt/bookforge/experiments/live-scenes/modal-plan.json
BOOKFORGE_LIVE_SCENE_MODAL_LEDGER_PATH=/var/lib/bookforge/live-scenes/modal-ledger.json
BOOKFORGE_LIVE_SCENE_GCP_URL=
BOOKFORGE_LIVE_SCENE_GCP_AUDIENCE=
BOOKFORGE_LIVE_SCENE_GCP_IMPERSONATE_SERVICE_ACCOUNT=bookforge-renderer@your-gcp-project.iam.gserviceaccount.com
BOOKFORGE_LIVE_SCENE_GCP_GPU=RTX_PRO_6000
BOOKFORGE_LIVE_SCENE_VERTEX_PROJECT_ID=your-gcp-project
BOOKFORGE_LIVE_SCENE_VERTEX_LOCATION=global
BOOKFORGE_LIVE_SCENE_VERTEX_MODEL=gemini-3.1-flash-lite-image
BOOKFORGE_LIVE_SCENE_VERTEX_TIMEOUT_SECONDS=90
BOOKFORGE_LIVE_SCENE_VERTEX_SESSION_COST_CAP_USD=0.50
BOOKFORGE_LIVE_SCENE_VERTEX_ESTIMATED_IMAGE_USD=0.034
BOOKFORGE_LIVE_SCENE_ROUTING_PROBE_TIMEOUT_SECONDS=2
BOOKFORGE_LIVE_SCENE_ROUTING_FAILURE_COOLDOWN_SECONDS=300
BOOKFORGE_LIVE_SCENE_ENABLE_PREVIEW=false
BOOKFORGE_LIVE_SCENE_ENABLE_MOTION=false
# The resilient router performs bounded readiness checks. Provider-specific
# prewarming stays explicit so a health failure cannot accidentally start two GPUs.
BOOKFORGE_LIVE_SCENE_AUTO_PREWARM_ON_SUBMIT=false
BOOKFORGE_LIVE_SCENE_MASTER_WIDTH=896
BOOKFORGE_LIVE_SCENE_MASTER_HEIGHT=512
BOOKFORGE_LIVE_SCENE_MASTER_STEPS=2
BOOKFORGE_LIVE_SCENE_MASTER_GUIDANCE_SCALE=4.5
# First projection wins the latency race. Grounding DINO/Nemotron evaluation
# runs only after the generated plate is already visible.
BOOKFORGE_LIVE_SCENE_FIDELITY_MODE=deferred
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Audio is deliberately outside the phone gateway milestone.
BOOKFORGE_ASR_BACKEND=disabled
BOOKFORGE_ASR_MODEL=base.en
BOOKFORGE_ASR_ENGINE_PATH=/var/cache/bookforge/whisper_trt/base-en-trt.pth
BOOKFORGE_ASR_MAX_AUDIO_MB=20

# The core API stays private. The paired gateway talks to it from loopback.
BOOKFORGE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
