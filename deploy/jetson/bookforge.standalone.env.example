# Standalone profile. Copy to /etc/bookforge/bookforge.env only after
# Gemma and Modal have independently passed their readiness checks.
BOOKFORGE_ENVIRONMENT=jetson
BOOKFORGE_DATA_DIR=/var/lib/bookforge
BOOKFORGE_CACHE_DIR=/var/cache/bookforge

# Private local scene planner on Jetson.
BOOKFORGE_MODEL_BACKEND=ollama
BOOKFORGE_MODEL_NAME=gemma3:1b-it-q4_K_M
BOOKFORGE_MODEL_BASE_URL=http://127.0.0.1:11434
BOOKFORGE_MODEL_API_KEY=
BOOKFORGE_MODEL_TIMEOUT_SECONDS=12
BOOKFORGE_MODEL_CONTEXT_TOKENS=4096
BOOKFORGE_MODEL_MAX_OUTPUT_TOKENS=180
BOOKFORGE_MODEL_REQUIRE_GPU=true
BOOKFORGE_MODEL_KEEP_ALIVE=30m
BOOKFORGE_LIVE_SCENE_PLANNER=model
BOOKFORGE_LIVE_SCENE_PLANNER_TIMEOUT_SECONDS=12
BOOKFORGE_LIVE_SCENE_PLANNER_CACHE_ENTRIES=32
BOOKFORGE_LIVE_SCENE_PLANNER_AUTO_WARMUP=true
BOOKFORGE_LIVE_SCENE_PLANNER_COMPACT_WIRE=true

# Authenticated, scale-to-zero renderer. Put Modal credentials only in the
# root-owned installed environment, never in this example or the repository.
BOOKFORGE_ASSET_BACKEND=modal
BOOKFORGE_ASSET_MODAL_COMMAND=/opt/bookforge/.venv/bin/modal
BOOKFORGE_LIVE_SCENE_BACKEND=modal_warm
BOOKFORGE_LIVE_SCENE_MODAL_PLAN_FILE=/opt/bookforge/experiments/live-scenes/modal-plan.json
BOOKFORGE_LIVE_SCENE_MODAL_LEDGER_PATH=/var/lib/bookforge/live-scenes/modal-ledger.json
BOOKFORGE_LIVE_SCENE_ENABLE_PREVIEW=true
BOOKFORGE_LIVE_SCENE_ENABLE_MOTION=false
BOOKFORGE_LIVE_SCENE_AUTO_PREWARM_ON_SUBMIT=true
BOOKFORGE_LIVE_SCENE_MASTER_WIDTH=896
BOOKFORGE_LIVE_SCENE_MASTER_HEIGHT=512
BOOKFORGE_LIVE_SCENE_MASTER_STEPS=2
BOOKFORGE_LIVE_SCENE_MASTER_GUIDANCE_SCALE=4.5
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Audio is deliberately outside the phone gateway milestone.
BOOKFORGE_ASR_BACKEND=disabled
BOOKFORGE_ASR_MODEL=base.en
BOOKFORGE_ASR_ENGINE_PATH=/var/cache/bookforge/whisper_trt/base-en-trt.pth
BOOKFORGE_ASR_MAX_AUDIO_MB=20

# The core API stays private. The paired gateway talks to it from loopback.
BOOKFORGE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
