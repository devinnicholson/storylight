# Standalone profile. Copy to /etc/storylight/storylight.env only after
# Gemma and Modal have independently passed their readiness checks.
STORYLIGHT_ENVIRONMENT=jetson
STORYLIGHT_DATA_DIR=/var/lib/storylight
STORYLIGHT_CACHE_DIR=/var/cache/storylight

# Private local scene planner on Jetson.
STORYLIGHT_MODEL_BACKEND=ollama
STORYLIGHT_MODEL_NAME=gemma3:1b-it-q4_K_M
STORYLIGHT_MODEL_BASE_URL=http://127.0.0.1:11434
STORYLIGHT_MODEL_API_KEY=
STORYLIGHT_MODEL_TIMEOUT_SECONDS=12
STORYLIGHT_MODEL_CONTEXT_TOKENS=4096
STORYLIGHT_MODEL_MAX_OUTPUT_TOKENS=180
STORYLIGHT_MODEL_REQUIRE_GPU=true
# A standalone judged appliance keeps its one accepted 1B planner resident.
# Use a bounded duration instead on shared/development devices.
STORYLIGHT_MODEL_KEEP_ALIVE=-1m
STORYLIGHT_LIVE_SCENE_PLANNER=model
# Default remains the configured Ollama client. The guarded TensorRT promotion
# helper atomically changes these settings only after the exact engine passes.
STORYLIGHT_LIVE_SCENE_PLANNER_BACKEND=configured
STORYLIGHT_LIVE_SCENE_PLANNER_BASE_URL=http://127.0.0.1:11435
STORYLIGHT_LIVE_SCENE_PLANNER_MODEL_NAME=llm
STORYLIGHT_LIVE_SCENE_PLANNER_MAX_OUTPUT_TOKENS=64
STORYLIGHT_LIVE_SCENE_PLANNER_FALLBACK_READY_SECONDS=5
STORYLIGHT_LIVE_SCENE_PLANNER_TIMEOUT_SECONDS=12
STORYLIGHT_LIVE_SCENE_PLANNER_CACHE_ENTRIES=32
STORYLIGHT_LIVE_SCENE_PLANNER_AUTO_WARMUP=true
STORYLIGHT_LIVE_SCENE_PLANNER_COMPACT_WIRE=false

# Resilient renderer order: private Cloud Run RTX, managed Vertex image, then
# authenticated Modal. Failed readiness probes fall through; an ambiguous paid
# request always fails closed instead of launching a duplicate render.
STORYLIGHT_ASSET_BACKEND=modal
STORYLIGHT_ASSET_MODAL_COMMAND=/opt/storylight/.venv/bin/modal
STORYLIGHT_LIVE_SCENE_BACKEND=gcp_resilient
STORYLIGHT_LIVE_SCENE_MODAL_PLAN_FILE=/opt/storylight/experiments/live-scenes/modal-plan.json
STORYLIGHT_LIVE_SCENE_MODAL_LEDGER_PATH=/var/lib/storylight/live-scenes/modal-ledger.json
STORYLIGHT_LIVE_SCENE_GCP_URL=
STORYLIGHT_LIVE_SCENE_GCP_AUDIENCE=
STORYLIGHT_LIVE_SCENE_GCP_IMPERSONATE_SERVICE_ACCOUNT=storylight-renderer@your-gcp-project.iam.gserviceaccount.com
STORYLIGHT_LIVE_SCENE_GCP_GPU=RTX_PRO_6000
STORYLIGHT_LIVE_SCENE_VERTEX_PROJECT_ID=your-gcp-project
STORYLIGHT_LIVE_SCENE_VERTEX_LOCATION=global
STORYLIGHT_LIVE_SCENE_VERTEX_MODEL=gemini-3.1-flash-lite-image
STORYLIGHT_LIVE_SCENE_VERTEX_TIMEOUT_SECONDS=90
STORYLIGHT_LIVE_SCENE_VERTEX_SESSION_COST_CAP_USD=0.50
STORYLIGHT_LIVE_SCENE_VERTEX_ESTIMATED_IMAGE_USD=0.034
STORYLIGHT_LIVE_SCENE_ROUTING_PROBE_TIMEOUT_SECONDS=2
STORYLIGHT_LIVE_SCENE_ROUTING_FAILURE_COOLDOWN_SECONDS=300
STORYLIGHT_LIVE_SCENE_ENABLE_PREVIEW=false
STORYLIGHT_LIVE_SCENE_ENABLE_MOTION=false
# The resilient router performs bounded readiness checks. Provider-specific
# prewarming stays explicit so a health failure cannot accidentally start two GPUs.
STORYLIGHT_LIVE_SCENE_AUTO_PREWARM_ON_SUBMIT=false
STORYLIGHT_LIVE_SCENE_MASTER_WIDTH=896
STORYLIGHT_LIVE_SCENE_MASTER_HEIGHT=512
STORYLIGHT_LIVE_SCENE_MASTER_STEPS=2
STORYLIGHT_LIVE_SCENE_MASTER_GUIDANCE_SCALE=4.5
# First projection wins the latency race. Grounding DINO/Nemotron evaluation
# runs only after the generated plate is already visible.
STORYLIGHT_LIVE_SCENE_FIDELITY_MODE=deferred
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Audio is deliberately outside the phone gateway milestone.
STORYLIGHT_ASR_BACKEND=disabled
STORYLIGHT_ASR_MODEL=base.en
STORYLIGHT_ASR_ENGINE_PATH=/var/cache/storylight/whisper_trt/base-en-trt.pth
STORYLIGHT_ASR_MAX_AUDIO_MB=20

# The core API stays private. The paired gateway talks to it from loopback.
STORYLIGHT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Exact next-page rehearsal remains off until a private GKE connection is configured.
STORYLIGHT_ANTICIPATORY_BACKEND=disabled
# Supervised bridge only; this depends on the workstation staying connected.
# STORYLIGHT_ANTICIPATORY_BACKEND=gke
# STORYLIGHT_ANTICIPATORY_URL=http://127.0.0.1:18082
# STORYLIGHT_ANTICIPATORY_ALLOW_LOOPBACK_HTTP=true
