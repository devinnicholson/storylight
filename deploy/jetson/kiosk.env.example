STORYLIGHT_KIOSK_URL="http://127.0.0.1:8080/projector?pack=latest&session=storylight-live&live=1"
STORYLIGHT_READY_URL=http://127.0.0.1:8080/readyz
STORYLIGHT_KIOSK_STARTUP_TIMEOUT=90
# Dedicated unattended demo only: permit an idle but still unlocked local X11
# session. Locked, remote, missing, and display-off sessions remain blocked.
# STORYLIGHT_KIOSK_ALLOW_IDLE=true
# Preferred override; accepts an absolute Chromium or Firefox executable.
# STORYLIGHT_BROWSER_BIN=/absolute/path/to/chromium-or-firefox
# The verified user-space ARM64 installer creates this stable path:
# STORYLIGHT_BROWSER_BIN=/home/your-user/.local/opt/firefox-storylight/firefox
# STORYLIGHT_FIREFOX_PROFILE=/home/your-user/.local/state/storylight/firefox
# Legacy Chromium-only override remains supported.
# STORYLIGHT_CHROMIUM_BIN=/absolute/path/to/chromium
# STORYLIGHT_CHROMIUM_PROFILE=/home/your-user/.local/state/storylight/chromium

# Mac-hosted development tunnel: override both values together so readiness and
# projector traffic use the same Jetson-loopback reverse forward.
# STORYLIGHT_KIOSK_URL="http://127.0.0.1:18081/projector?pack=latest&session=storylight-live&live=1&present=1"
# STORYLIGHT_READY_URL=http://127.0.0.1:18081/readyz
