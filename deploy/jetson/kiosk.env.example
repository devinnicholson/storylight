BOOKFORGE_KIOSK_URL="http://127.0.0.1:8080/projector?pack=latest&session=bookforge-live&live=1"
BOOKFORGE_READY_URL=http://127.0.0.1:8080/readyz
BOOKFORGE_KIOSK_STARTUP_TIMEOUT=90
# Preferred override; accepts an absolute Chromium or Firefox executable.
# BOOKFORGE_BROWSER_BIN=/absolute/path/to/chromium-or-firefox
# The verified user-space ARM64 installer creates this stable path:
# BOOKFORGE_BROWSER_BIN=/home/your-user/.local/opt/firefox-bookforge/firefox
# Legacy Chromium-only override remains supported.
# BOOKFORGE_CHROMIUM_BIN=/absolute/path/to/chromium
# BOOKFORGE_CHROMIUM_PROFILE=/home/your-user/.local/state/bookforge/chromium

# Mac-hosted development tunnel: override both values together so readiness and
# projector traffic use the same Jetson-loopback reverse forward.
# BOOKFORGE_KIOSK_URL="http://127.0.0.1:18081/projector?pack=latest&session=bookforge-live&live=1&present=1"
# BOOKFORGE_READY_URL=http://127.0.0.1:18081/readyz
