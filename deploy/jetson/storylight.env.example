# Copy to /etc/storylight/storylight.env for the system service. Never commit secrets.
STORYLIGHT_ENVIRONMENT=jetson
STORYLIGHT_DATA_DIR=/var/lib/storylight
STORYLIGHT_CACHE_DIR=/var/cache/storylight

# Safe first boot: deterministic model responses and no microphone processing.
STORYLIGHT_MODEL_BACKEND=fake
STORYLIGHT_MODEL_NAME=fake
STORYLIGHT_MODEL_BASE_URL=http://127.0.0.1:11434
STORYLIGHT_MODEL_API_KEY=
STORYLIGHT_MODEL_TIMEOUT_SECONDS=180
STORYLIGHT_MODEL_KEEP_ALIVE=10m

# Accepted live-scene profile after the local model and SSH/API topology pass
# hardware validation. Replace the safe fake values above rather than enabling
# these comments blindly on first boot.
# STORYLIGHT_MODEL_BACKEND=ollama
# STORYLIGHT_MODEL_NAME=gemma3:1b-it-q4_K_M
# STORYLIGHT_MODEL_CONTEXT_TOKENS=4096
# STORYLIGHT_MODEL_MAX_OUTPUT_TOKENS=180
# Fail closed if a warmed Ollama model falls back to CPU after a GPU firmware problem.
# STORYLIGHT_MODEL_REQUIRE_GPU=true
# STORYLIGHT_MODEL_KEEP_ALIVE=30m
# STORYLIGHT_LIVE_SCENE_PLANNER=model
# Hardware-accepted Gemma 4 TensorRT candidate. Use configure-tensorrt-planner.sh
# after its exact engine passes the on-device acceptance gate; do not enable by hand.
# STORYLIGHT_LIVE_SCENE_PLANNER_BACKEND=tensorrt_slots
# Research-only fidelity A/B; keep tensorrt_slots as the appliance default:
# STORYLIGHT_LIVE_SCENE_PLANNER_BACKEND=tensorrt_hybrid
# STORYLIGHT_LIVE_SCENE_PLANNER_BASE_URL=http://127.0.0.1:11435
# STORYLIGHT_LIVE_SCENE_PLANNER_MODEL_NAME=llm
# STORYLIGHT_LIVE_SCENE_PLANNER_MAX_OUTPUT_TOKENS=64
# STORYLIGHT_LIVE_SCENE_PLANNER_FALLBACK_READY_SECONDS=5
# STORYLIGHT_LIVE_SCENE_PLANNER_TIMEOUT_SECONDS=12
# Bounded local semantic-plan LRU; set to 0 to disable repeated-passage reuse.
# STORYLIGHT_LIVE_SCENE_PLANNER_CACHE_ENTRIES=32
# Hide the local model-load cost while the workbench user is typing. No story text is used.
# STORYLIGHT_LIVE_SCENE_PLANNER_AUTO_WARMUP=true
# Research-only positional tuple output is faster but failed the semantic-fidelity gate.
# Keep false for production; enable only for explicit local A/B experiments.
# STORYLIGHT_LIVE_SCENE_PLANNER_COMPACT_WIRE=false
# STORYLIGHT_LIVE_SCENE_MASTER_WIDTH=1024
# STORYLIGHT_LIVE_SCENE_MASTER_HEIGHT=576
# STORYLIGHT_LIVE_SCENE_MASTER_STEPS=2
# STORYLIGHT_LIVE_SCENE_MASTER_GUIDANCE_SCALE=4.5
# Keep inline for fail-closed Grounding DINO. Set deferred only when a
# post-projection critic is configured and first-image latency takes priority.
# STORYLIGHT_LIVE_SCENE_FIDELITY_MODE=inline
# Emit a sub-second warm provisional plate only while a new Gemma plan is uncached.
# STORYLIGHT_LIVE_SCENE_ENABLE_PREVIEW=true
# Overlap privacy-safe Modal model preparation with local Gemma planning.
# STORYLIGHT_LIVE_SCENE_AUTO_PREWARM_ON_SUBMIT=true

# Optional GKE anticipatory path. Leave disabled until the bounded live GKE/NIM
# harness passes. Loopback HTTP is allowed only for a supervised port-forward;
# production ingress must be authenticated HTTPS.
STORYLIGHT_ANTICIPATORY_BACKEND=disabled
# STORYLIGHT_ANTICIPATORY_URL=http://127.0.0.1:18082
# STORYLIGHT_ANTICIPATORY_ALLOW_LOOPBACK_HTTP=true
# STORYLIGHT_ANTICIPATORY_TIMEOUT_SECONDS=30
# STORYLIGHT_ANTICIPATORY_EDGE_GATE_REVISION=sanitized-scene-spec-v1
# STORYLIGHT_ANTICIPATORY_AUDIENCE=https://IAP_PROTECTED_GKE_ENDPOINT

# Start disabled for first boot. After installing and validating NVIDIA-AI-IOT
# whisper_trt, select whisper_trt and keep its generated engine on persistent NVMe.
STORYLIGHT_ASR_BACKEND=disabled
STORYLIGHT_ASR_MODEL=base.en
STORYLIGHT_ASR_ENGINE_PATH=/var/cache/storylight/whisper_trt/base-en-trt.pth
STORYLIGHT_ASR_MAX_AUDIO_MB=20

STORYLIGHT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
