[Unit]
Description=Bookforge projector browser kiosk
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-%h/.config/bookforge/kiosk.env
ExecStart=/opt/bookforge/deploy/jetson/launch-kiosk.sh
Restart=always
RestartPreventExitStatus=78
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
