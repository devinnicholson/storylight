[Unit]
Description=Bookforge Chromium projector kiosk
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/bookforge/kiosk.env
ExecStart=/opt/bookforge/deploy/jetson/launch-kiosk.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
