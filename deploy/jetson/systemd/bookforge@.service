[Unit]
Description=Bookforge edge API for user %i
After=local-fs.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/bookforge
EnvironmentFile=/etc/bookforge/bookforge.env
Environment=HOME=/var/cache/bookforge/home
Environment=PATH=/opt/bookforge/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=/opt/bookforge/.venv/bin/python -m bookforge.edge_preflight
ExecStart=/opt/bookforge/.venv/bin/python -m uvicorn bookforge.api:app --host 127.0.0.1 --port 8080 --timeout-graceful-shutdown 3
# This is an appliance service: a graceful process exit is still unexpected.
# `systemctl stop` remains authoritative and does not trigger Restart=always.
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=bookforge
StateDirectoryMode=0700
CacheDirectory=bookforge
CacheDirectoryMode=0700
RuntimeDirectory=bookforge
RuntimeDirectoryMode=0700
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
