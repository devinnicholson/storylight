[Unit]
Description=Bookforge local Gemma runtime (Ollama)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.local/share/bookforge/ollama/models
Environment=OLLAMA_KEEP_ALIVE=-1m
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_MAX_QUEUE=8
Environment=OLLAMA_NOHISTORY=1
Environment=OLLAMA_NO_CLOUD=1
ExecStart=%h/.local/opt/ollama-v0.32.15/bin/ollama serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/bookforge/ollama %h/.ollama %h/.nv
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryHigh=3G
MemoryMax=3500M
MemorySwapMax=0
TasksMax=64
OOMScoreAdjust=250
UMask=0077

[Install]
WantedBy=default.target
