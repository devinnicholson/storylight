[Unit]
Description=Storylight resident Gemma 4 TensorRT scene planner
After=network-online.target
Wants=network-online.target
Conflicts=storylight-gemma.service
Before=storylight-kiosk.service

[Service]
Type=simple
Environment=EDGELLM_GEMMA4_PLE_STORAGE_BACKED=1
Environment=STORYLIGHT_EDGELLM_SERVER_PORT=11435
ExecStart=/opt/storylight/deploy/jetson/run-tensorrt-edge-server.sh %h/.local/share/storylight/tensorrt-edgellm-v0.10.0/models/gemma4-e2b-it-int4-awq-v010/engines/llm
ExecStartPost=/opt/storylight/deploy/jetson/wait-tensorrt-planner-ready.sh
# Queue the smaller Ollama planner after any normal stop or crash. --no-block
# prevents a conflict transaction from deadlocking this unit's final process.
ExecStopPost=-/usr/bin/systemctl --user --no-block start storylight-gemma.service
Restart=no
TimeoutStartSec=90
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/storylight/tensorrt-edgellm-v0.10.0 %h/.nv
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryHigh=5G
MemoryMax=6G
MemorySwapMax=0
TasksMax=128
OOMScoreAdjust=100
UMask=0077

[Install]
WantedBy=default.target
