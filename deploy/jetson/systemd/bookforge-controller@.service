[Unit]
Description=Bookforge paired phone controller for user %i
Requires=bookforge@%i.service
After=network-online.target bookforge@%i.service
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/bookforge
EnvironmentFile=/etc/bookforge/controller.env
Environment=HOME=/var/cache/bookforge/home
ExecStart=/opt/bookforge/.venv/bin/python -m uvicorn bookforge.controller_gateway:create_app_from_env --factory --host 0.0.0.0 --port 8081 --no-proxy-headers --timeout-graceful-shutdown 3
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=bookforge
StateDirectoryMode=0700
CacheDirectory=bookforge
CacheDirectoryMode=0700
RuntimeDirectory=bookforge-controller
RuntimeDirectoryMode=0700
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
