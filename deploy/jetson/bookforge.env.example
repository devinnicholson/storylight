# Copy to /etc/bookforge/bookforge.env for the system service. Never commit secrets.
BOOKFORGE_ENVIRONMENT=jetson
BOOKFORGE_DATA_DIR=/var/lib/bookforge
BOOKFORGE_CACHE_DIR=/var/cache/bookforge

# Safe first boot: deterministic model responses and no microphone processing.
BOOKFORGE_MODEL_BACKEND=fake
BOOKFORGE_MODEL_NAME=fake
BOOKFORGE_MODEL_BASE_URL=http://127.0.0.1:11434
BOOKFORGE_MODEL_API_KEY=
BOOKFORGE_MODEL_TIMEOUT_SECONDS=180
BOOKFORGE_MODEL_KEEP_ALIVE=10m

# Start disabled for first boot. After installing and validating NVIDIA-AI-IOT
# whisper_trt, select whisper_trt and keep its generated engine on persistent NVMe.
BOOKFORGE_ASR_BACKEND=disabled
BOOKFORGE_ASR_MODEL=base.en
BOOKFORGE_ASR_ENGINE_PATH=/var/cache/bookforge/whisper_trt/base-en-trt.pth
BOOKFORGE_ASR_MAX_AUDIO_MB=20

BOOKFORGE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
