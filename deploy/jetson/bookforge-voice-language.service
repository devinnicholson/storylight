[Unit]
Description=Bookforge local voice scene interpretation

[Service]
Type=simple
WorkingDirectory=/opt/bookforge
Environment=PYTHONPATH=/opt/bookforge/voice-language-current
ExecStart=/opt/bookforge/.venv-voice-language/bin/python -m bookforge.voice_language --socket %t/bookforge-voice-language/parser.sock
RuntimeDirectory=bookforge-voice-language
RuntimeDirectoryMode=0700
UMask=0077
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=default.target
