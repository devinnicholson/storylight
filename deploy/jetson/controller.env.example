# Copy to /etc/storylight/controller.env. Generate a unique token; never commit it.
STORYLIGHT_CONTROLLER_BACKEND_URL=http://127.0.0.1:8080
STORYLIGHT_CONTROLLER_PAIRING_TOKEN=
STORYLIGHT_CONTROLLER_SESSION_TTL_SECONDS=43200
STORYLIGHT_CONTROLLER_MAXIMUM_SESSIONS=8
STORYLIGHT_CONTROLLER_COOKIE_SECURE=false
STORYLIGHT_CONTROLLER_PUBLIC_NAME=Storylight
