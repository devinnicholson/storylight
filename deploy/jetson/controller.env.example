# Copy to /etc/bookforge/controller.env. Generate a unique token; never commit it.
BOOKFORGE_CONTROLLER_BACKEND_URL=http://127.0.0.1:8080
BOOKFORGE_CONTROLLER_PAIRING_TOKEN=
BOOKFORGE_CONTROLLER_SESSION_TTL_SECONDS=43200
BOOKFORGE_CONTROLLER_MAXIMUM_SESSIONS=8
BOOKFORGE_CONTROLLER_COOKIE_SECURE=false
BOOKFORGE_CONTROLLER_PUBLIC_NAME=Bookforge
