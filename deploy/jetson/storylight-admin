#!/usr/bin/env bash
# Root-owned, allowlisted Storylight device administration entry point.

set -euo pipefail
IFS=$'\n\t'
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset BASH_ENV ENV CDPATH GLOBIGNORE

readonly CONFIG_FILE="/etc/storylight/admin.conf"
readonly POWER_RUNNER="/usr/local/libexec/storylight/run-power-mode-ab.sh"
readonly SWAP_RUNNER="/usr/local/libexec/storylight/run-tensorrt-build-swap.sh"

usage() {
  cat <<'EOF'
Usage: sudo storylight-admin COMMAND [ACTION]

Commands:
  status              Read power mode and service readiness.
  restart-api         Restart only the Storylight API system service.
  restart-controller  Restart only the Storylight controller system service.
  restart-all         Restart the API and controller system services.
  power ACTION        Run status, prepare-maxn, benchmark-maxn, restore-25w, or finalize.
  build-swap ACTION   Run status, prepare, or cleanup for the fixed temporary TensorRT swap file.

This wrapper intentionally provides no shell, arbitrary systemctl target, arbitrary file path,
package installation, network mutation, or unrestricted command execution.
EOF
}

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  printf 'storylight-admin must run through sudo.\n' >&2
  exit 64
fi
if [[ ! -f "$CONFIG_FILE" ]] || [[ "$(stat -c '%U:%G:%a' "$CONFIG_FILE")" != "root:root:600" ]]; then
  printf 'Storylight administrator configuration is missing or has unsafe ownership/mode.\n' >&2
  exit 78
fi

admin_user="$(sed -n 's/^STORYLIGHT_ADMIN_USER=//p' "$CONFIG_FILE")"
if [[ ! "$admin_user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || ! id "$admin_user" >/dev/null 2>&1; then
  printf 'Configured Storylight administrator is invalid.\n' >&2
  exit 78
fi
readonly ADMIN_USER="$admin_user"
readonly API_UNIT="storylight@${ADMIN_USER}.service"
readonly CONTROLLER_UNIT="storylight-controller@${ADMIN_USER}.service"

require_no_extra_args() {
  if [[ $# -ne 0 ]]; then
    printf 'Unexpected arguments.\n' >&2
    usage >&2
    exit 64
  fi
}

wait_for_api() {
  local attempt
  for attempt in $(seq 1 30); do
    if curl --fail --silent --max-time 1 http://127.0.0.1:8080/readyz >/dev/null; then
      return
    fi
    sleep 1
  done
  printf 'Storylight API did not become ready after restart.\n' >&2
  exit 71
}

status() {
  printf '%s\n' '== power =='
  nvpmodel -q
  printf '%s\n' '== services =='
  systemctl is-active "$API_UNIT"
  systemctl is-active "$CONTROLLER_UNIT"
  printf '%s\n' '== readiness =='
  curl --fail --silent --show-error http://127.0.0.1:8080/readyz
  printf '\n'
  curl --fail --silent --show-error http://127.0.0.1:8081/healthz
  printf '\n'
}

case "${1:-}" in
  status)
    shift
    require_no_extra_args "$@"
    status
    ;;
  restart-api)
    shift
    require_no_extra_args "$@"
    systemctl restart "$API_UNIT"
    wait_for_api
    printf 'Storylight API restarted and is ready.\n'
    ;;
  restart-controller)
    shift
    require_no_extra_args "$@"
    systemctl restart "$CONTROLLER_UNIT"
    systemctl is-active --quiet "$CONTROLLER_UNIT"
    printf 'Storylight controller restarted and is active.\n'
    ;;
  restart-all)
    shift
    require_no_extra_args "$@"
    systemctl restart "$API_UNIT" "$CONTROLLER_UNIT"
    wait_for_api
    systemctl is-active --quiet "$CONTROLLER_UNIT"
    printf 'Storylight API and controller restarted successfully.\n'
    ;;
  power)
    if [[ $# -ne 2 ]]; then
      usage >&2
      exit 64
    fi
    case "$2" in
      status|prepare-maxn|benchmark-maxn|restore-25w|finalize) ;;
      *)
        printf 'Unsupported power action: %s\n' "$2" >&2
        exit 64
        ;;
    esac
    if [[ ! -x "$POWER_RUNNER" ]] \
      || [[ "$(stat -c '%U:%G:%a' "$POWER_RUNNER")" != "root:root:755" ]]; then
      printf 'Root-owned Storylight power runner is missing or unsafe.\n' >&2
      exit 78
    fi
    STORYLIGHT_POWER_AB_USER="$ADMIN_USER" exec "$POWER_RUNNER" "$2"
    ;;
  build-swap)
    if [[ $# -ne 2 ]]; then
      usage >&2
      exit 64
    fi
    case "$2" in
      status|prepare|cleanup) ;;
      *)
        printf 'Unsupported build-swap action: %s\n' "$2" >&2
        exit 64
        ;;
    esac
    if [[ ! -x "$SWAP_RUNNER" ]] \
      || [[ "$(stat -c '%U:%G:%a' "$SWAP_RUNNER")" != "root:root:755" ]]; then
      printf 'Root-owned Storylight TensorRT swap runner is missing or unsafe.\n' >&2
      exit 78
    fi
    exec "$SWAP_RUNNER" "$2"
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
