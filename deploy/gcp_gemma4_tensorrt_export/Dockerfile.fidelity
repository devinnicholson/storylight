ARG NVIDIA_PYTORCH_IMAGE
FROM ${NVIDIA_PYTORCH_IMAGE}

ARG EDGELLM_REVISION=71dd1bae032e70771265917ec74d3ff4cad07a10

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/tmp/bookforge-export/huggingface \
    HF_HUB_CACHE=/tmp/bookforge-export/huggingface/hub \
    HF_XET_HIGH_PERFORMANCE=1 \
    TOKENIZERS_PARALLELISM=false \
    PYTHONPATH=/opt/bookforge

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/NVIDIA/TensorRT-Edge-LLM.git /opt/tensorrt-edge-llm \
    && git -C /opt/tensorrt-edge-llm checkout "${EDGELLM_REVISION}" \
    && test "$(git -C /opt/tensorrt-edge-llm rev-parse HEAD)" = "${EDGELLM_REVISION}" \
    && test -z "$(git -C /opt/tensorrt-edge-llm status --porcelain)" \
    && python -m pip install --no-cache-dir -e '/opt/tensorrt-edge-llm[tools]' \
       google-cloud-storage==3.4.1

COPY deploy/gcp_gemma4_tensorrt_export/export_fidelity_candidate.py \
    /opt/bookforge/deploy/gcp_gemma4_tensorrt_export/export_fidelity_candidate.py
COPY scripts/validate_fidelity_release.py /opt/bookforge/scripts/validate_fidelity_release.py

ENTRYPOINT ["python", "/opt/bookforge/deploy/gcp_gemma4_tensorrt_export/export_fidelity_candidate.py"]
